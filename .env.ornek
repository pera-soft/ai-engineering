# Kopyala:  cp .env.ornek .env   sonra asagidaki satira YENI (rotate edilmis) anahtarini yaz.
# .env git-disidir (asla commit edilmez). Bu ornek dosya sir icermez.
OPENROUTER_API_KEY=buraya-YENI-anahtarini-yaz

# --- Girişsiz site profili (Faz 10, ADR-0017) — yalnız --spring.profiles.active=site ile ---
# Sitede OPENROUTER_API_KEY KULLANILMAZ (ziyaretçi kendi anahtarını getirir); hesap/e-posta/SMTP yok.
# Gerçek değerleri yalnız sunucudaki env dosyasına yaz; bu dosyaya/git'e ASLA şifre koyma.
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/site-deneme
# APP_SITE_IZINLI_ORIGINLER=https://egitim.ornek.com
# Yalnız yerel http denemesi:
# APP_SITE_GUVENLI_CEREZ=false
