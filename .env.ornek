# Kopyala:  cp .env.ornek .env   sonra asagidaki satira YENI (rotate edilmis) anahtarini yaz.
# .env git-disidir (asla commit edilmez). Bu ornek dosya sir icermez.
OPENROUTER_API_KEY=buraya-YENI-anahtarini-yaz

# --- Çok kullanıcılı site profili (Faz 9, ADR-0012/0013) — yalnız --spring.profiles.active=site ile ---
# Gerçek değerleri yalnız sunucudaki .env'e yaz; bu dosyaya/git'e ASLA şifre koyma.
# APP_SITE_TEMEL_URL=https://egitim.pera.software
# APP_SITE_IZINLI_ORIGINLER=https://egitim.pera.software
# APP_SITE_GONDERICI=AI Öğretmen <noreply@pera.software>
# SMTP (zorunlu; yoksa site açılmaz). STARTTLS varsayılan açık ve zorunlu.
# SPRING_MAIL_HOST=smtp.ornek-saglayici.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=noreply@pera.software
# SPRING_MAIL_PASSWORD=buraya-smtp-sifresi
# Yalnız yerel deneme (SMTP'siz, bağlantılar loga yazılır; canlıda KULLANMA):
# APP_SITE_EPOSTA_ZORUNLU=false
# APP_SITE_GUVENLI_CEREZ=false
