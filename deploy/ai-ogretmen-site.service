# AI Öğretmen — çok kullanıcılı site (Faz 9d, ADR-0012/0014). Kurulum: docs/kurulum-site.md
#   sudo cp deploy/ai-ogretmen-site.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ai-ogretmen-site
#
# Uygulama YALNIZ 127.0.0.1:8090'a bağlanır (application.yml server.address); dışarıya nginx/TLS açılır.
# Sırlar bu dosyada DEĞİL: /etc/ai-ogretmen/site.env (sahibi root, izin 0640, grup ai-ogretmen).

[Unit]
Description=AI Ogretmen - cok kullanicili egitim sitesi
Documentation=file:///opt/ai-ogretmen/docs/kurulum-site.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ai-ogretmen
Group=ai-ogretmen
# content/ ve prompts/ ile data/ bu dizine GÖRELİ okunur (./content, ./prompts, ./data)
WorkingDirectory=/opt/ai-ogretmen
EnvironmentFile=/etc/ai-ogretmen/site.env
# Bellek: 60 kullanıcı, tek örnek. Sunucunun RAM'ine göre -Xmx'i ayarla (en az 512m önerilir).
ExecStart=/usr/bin/java -Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError \
  -Djava.security.egd=file:/dev/urandom -Dfile.encoding=UTF-8 \
  -Dspring.profiles.active=site \
  -jar /opt/ai-ogretmen/ai-ogretmen.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
# kuyruktaki e-postalar için kapanışta en çok ~10 sn beklenir (ADR-0013)
TimeoutStopSec=30

# --- Sertleştirme ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027
# Yazılabilir tek yer: kişisel hafıza + rapor önbelleği (data/hafiza, data/raporlar)
ReadWritePaths=/opt/ai-ogretmen/data

[Install]
WantedBy=multi-user.target
