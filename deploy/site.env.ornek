# /etc/ai-ogretmen/site.env — AI Öğretmen sitesinin ortam değişkenleri (ŞABLON; gerçek değerler GİT'E GİRMEZ)
#   sudo install -d -m 0750 -o root -g ai-ogretmen /etc/ai-ogretmen
#   sudo install -m 0640 -o root -g ai-ogretmen deploy/site.env.ornek /etc/ai-ogretmen/site.env
#   sudo nano /etc/ai-ogretmen/site.env      # <...> yer tutucularını doldur
# systemd EnvironmentFile biçimi: ANAHTAR=değer (tırnak gerekmez; satır sonu yorumu YAZMA).
# <...> ve 'gonderici-hesap' yer tutucudur.

# --- AI (OpenRouter, ADR-0004) — pera'nın şirket anahtarı ---
OPENROUTER_API_KEY=<openrouter-anahtari>

# --- Veritabanı (PostgreSQL, ADR-0014) — ZORUNLU; yoksa site açılmaz ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/ai_ogretmen
SPRING_DATASOURCE_USERNAME=ai_ogretmen
SPRING_DATASOURCE_PASSWORD=<veritabani-sifresi>
# Bağlantı havuzu (varsayılan 10)
# APP_SITE_DB_HAVUZ=10

# --- Kayıt yöntemi (ADR-0015) — varsayılan ekip-kodu: site e-posta GÖNDERMEZ ---
APP_SITE_KAYIT=ekip-kodu
# Ortak ekip kodu — ZORUNLU (ekip-kodu modunda), en az 12 karakter; yoksa site açılmaz.
# Üret:  openssl rand -base64 18     · Ekibe güvenli kanaldan ilet; git'e/vault'a YAZMA.
# Sızarsa: yeni kod üret, buraya yaz, systemctl restart ai-ogretmen-site (mevcut hesaplar etkilenmez)
APP_SITE_EKIP_KODU=<ekip-kodu>

# --- E-posta (SMTP, ADR-0013) — YALNIZ APP_SITE_KAYIT=eposta iken; o modda ZORUNLU ---
# Ekip kodu modunda bu blok yorum satırı kalır (SMTP gerekmez).
# SPRING_MAIL_HOST=<smtp-sunucusu>
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=gonderici-hesap@pera.software
# SPRING_MAIL_PASSWORD=<smtp-sifresi>
# "Kimden" — boşluklu değer tırnaksız yazılabilir; adres SMTP hesabıyla aynı olmalı
# APP_SITE_GONDERICI=AI Öğretmen <gonderici-hesap@pera.software>
# STARTTLS zorunlu (varsayılan true) — yalnız yerel denemede false
# APP_SITE_SMTP_STARTTLS=true
# APP_SITE_SMTP_AUTH=true
# SMTP yoksa açılma (eposta modunda canlıda DAİMA true)
# APP_SITE_EPOSTA_ZORUNLU=true

# --- Site adresi (nginx önündeki gerçek https adres) ---
# Bağlantıların kökü (tools/sifre-baglantisi.sh ve eposta modu; Host başlığından türetilmez)
APP_SITE_TEMEL_URL=https://egitim.pera.software
# CSRF Origin denetimi: tarayıcının gönderdiği origin birebir (virgülle çoklu)
APP_SITE_IZINLI_ORIGINLER=https://egitim.pera.software
# Çerezler Secure (canlıda DAİMA true; yalnız yerel http denemesinde false)
APP_SITE_GUVENLI_CEREZ=true
